     if not any(Path(r["source"]).suffix==".svg" for r in receipts):raise ValueError("No bound vector cache")
     return receipts
 
+
+FRACTION_ARRAY_RE = __import__("re").compile(
+    r"\\begin\{(pmatrix|bmatrix|Bmatrix|vmatrix|Vmatrix|matrix|smallmatrix|array|cases)\}(.*?)\\end\{\1\}",
+    __import__("re").S)
+def needs_fraction_spacing(formula):
+    return any(__import__("re").search(r"\\(?:d|t|c)?frac(?![A-Za-z])", match.group(2))
+               for match in FRACTION_ARRAY_RE.finditer(formula))
+
+SPACED_TEMPLATE_SOURCE = r'''
+def fraction_template(template=None):
+    template=deepcopy(template) if template is not None else TexTemplate()
+    template.add_to_preamble(r"\renewcommand{\arraystretch}{2}")
+    return template
+'''
+
 def hd_scene(formulas,rid):
     source=base.scene_source(formulas,rid)
+    if any(needs_fraction_spacing(f) for f in formulas):
+        source="from copy import deepcopy\n"+source
+        source=source.replace("class ConceptScene(Scene):", SPACED_TEMPLATE_SOURCE+"\nclass ConceptScene(Scene):", 1)
+        chinese="maths=[MathTex(formula, font_size=48, tex_template=template) for formula in FORMULAS]"
+        regular="maths=[MathTex(formula, font_size=48) for formula in FORMULAS]"
+        if source.count(chinese)!=1 or source.count(regular)!=1:
+            raise ValueError("Pinned scene construction contract changed")
+        source=source.replace(chinese,"maths=[MathTex(formula, font_size=48, tex_template=fraction_template(template) if needs_fraction_spacing(formula) else template) for formula in FORMULAS]",1)
+        source=source.replace(regular,"maths=[MathTex(formula, font_size=48, tex_template=fraction_template()) if needs_fraction_spacing(formula) else MathTex(formula, font_size=48) for formula in FORMULAS]",1)
+        source="import re\n"+__import__("inspect").getsource(needs_fraction_spacing)+"\nFRACTION_ARRAY_RE=re.compile("+repr(FRACTION_ARRAY_RE.pattern)+",re.S)\n"+source
     return source.replace('"schema":"exact-formula-pages-v1"',
                           '"schema":"exact-formula-pages-hd-v1","pixel_width":config.pixel_width,"pixel_height":config.pixel_height,"fps":str(config.frame_rate),"page_seconds":"3"')
 
