{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "witness-transfer-ready-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "round",
    "capture_id",
    "package_sha256",
    "package_bytes",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "witness-transfer-ready-v1"
    },
    "purpose": {
      "enum": [
        "EXPERIMENT_TRANSFER",
        "DESIGN_FIXTURE_ONLY"
      ]
    },
    "round": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
