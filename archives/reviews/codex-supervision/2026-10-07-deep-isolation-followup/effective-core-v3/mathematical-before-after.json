          "两个剩余因子在对应零点处均为 $-\\frac14\\ne0$"
        ],
        "steps": [
          "从互素性推出乘积整除。",
          "由次数界把可行多项式限制为单个常数倍。",
          "由 $f(0)=1$ 精确确定常数。",
          "验证精确重数并证明唯一性。"
        ]
      },
