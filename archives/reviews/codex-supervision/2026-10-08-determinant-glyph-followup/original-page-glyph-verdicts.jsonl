{"formulas": [{"index": 7, "tex": "=\\dfrac{4}{3}\\cdot\\dfrac{1}{3}(-2,1,2)=\\left(-\\dfrac{8}{9},\\dfrac{4}{9},\\dfrac{8}{9}\\right)"}, {"index": 8, "tex": "|\\vec a-\\vec b|^2=|(3,1,0)|^2=10"}, {"index": 9, "tex": "|\\vec a|=|\\vec b|=3"}, {"index": 10, "tex": "\\cos\\theta=(9+9-10)/(2\\cdot3\\cdot3)=4/9"}, {"index": 11, "tex": "\\cos\\theta=\\dfrac{4}{9}"}], "id": "eval-geom-017-s2", "kind": "FULL_FORMULAS", "math_sha256": "eb7535726a0849f86f583c62d2d105f4eab13acb31020eb848a9501b5b666754", "notes": "投影三分数(-8/9,4/9,8/9)、范数平方10、余弦4/9皆清楚，括号和负号完整。", "ordinal": 250, "page": 2, "path": "reviews/codex-supervision/2026-10-08-hd-formula-mail-review/shard-2/render-eval-geom-017-s2/pages/page-002.png", "record_sha256": "e2e0590f4e8f73e4926e3360a51c770f6d5736fab9c86a2e1fe67f304f16fe49", "review_method": "ACTUAL_INDIVIDUAL_PNG_VIEW_WITH_SOURCE_TEX_COMPARISON", "review_status": "NEEDS_EVIDENCE_NOT_INSPECTED", "segment_judgment": "NOT_APPLICABLE", "sha256": "ff7819c67752e7c44d55571e77440c83153447c421c1cf6515c2b509906682e1", "source_version_scope": "CURRENT_UNCHANGED_RECORD", "status": "PASS", "tile": null, "tile_grid": null, "verdict_source": null}
