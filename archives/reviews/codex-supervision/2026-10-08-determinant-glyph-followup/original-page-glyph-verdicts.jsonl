{"formulas": [{"index": 7, "tex": "\\cos^2\\alpha=\\dfrac{a^2}{a^2+b^2}"}, {"index": 8, "tex": "\\kappa=\\dfrac{\\cos^2\\alpha}{a}=\\dfrac{a}{a^2+b^2}"}, {"index": 9, "tex": "\\tau=\\dfrac{\\sin\\alpha\\cos\\alpha}{a}=\\dfrac{b}{a^2+b^2}"}, {"index": 10, "tex": "\\dfrac{\\tau}{\\kappa}=\\dfrac{b}{a}"}, {"index": 11, "tex": "e_r=(\\cos t,\\sin t,0)"}], "id": "eval-geom-012-s3", "kind": "FULL_FORMULAS", "math_sha256": "8768a4344ade9144cfc9bcf5ed83cfd070120e84cd147d35dd72e924e94c88a3", "notes": "cos²α分式、曲率κ、挠率τ与τ/κ=b/a及e_r坐标清楚，平方与根本方向正确。", "ordinal": 241, "page": 2, "path": "reviews/codex-supervision/2026-10-08-hd-formula-mail-review/shard-1/render-eval-geom-012-s3/pages/page-002.png", "record_sha256": "da517679967558ea2ab2ca90c7d4c5b8d1ea188886708c0aaa85a4407205521a", "review_method": "ACTUAL_INDIVIDUAL_PNG_VIEW_WITH_SOURCE_TEX_COMPARISON", "review_status": "NEEDS_EVIDENCE_NOT_INSPECTED", "segment_judgment": "NOT_APPLICABLE", "sha256": "81fef38f8b17df00f754f2c5d42afddb1cba6d63b5858925590d48503997cfc0", "source_version_scope": "CURRENT_UNCHANGED_RECORD", "status": "PASS", "tile": null, "tile_grid": null, "verdict_source": null}
