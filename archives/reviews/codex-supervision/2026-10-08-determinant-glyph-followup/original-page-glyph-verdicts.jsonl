{"formulas": [{"index": 13, "tex": "2\\vec a,\\vec b"}, {"index": 14, "tex": "2\\vec a-\\vec b"}, {"index": 15, "tex": "|2\\vec a-\\vec b|^2=16+9-2\\cdot4\\cdot3\\cos(\\pi/3)=13"}, {"index": 16, "tex": "|\\vec a-\\vec b|^2=4+9-2\\cdot2\\cdot3\\cos(\\pi/3)=7"}, {"index": 17, "tex": "(\\vec a+\\vec b)\\cdot(\\vec a-\\vec b)=|\\vec a|^2-|\\vec b|^2=-5"}, {"index": 18, "tex": "-5/\\sqrt{19\\cdot7}=-5/\\sqrt{133}"}], "id": "eval-geom-016-s3", "kind": "FULL_FORMULAS", "math_sha256": "e972ae6ebc6c436f76d66ec81dc9bdf721dea1f9f43fdde53b727396de2a2ace", "notes": "两差向量模方13和7、对角线点积-5、分母sqrt(19·7)=sqrt133均完整且无裁切。", "ordinal": 247, "page": 3, "path": "reviews/codex-supervision/2026-10-08-hd-formula-mail-review/shard-1/render-eval-geom-016-s3/pages/page-003.png", "record_sha256": "e42e482cde7a4d71ee9aa4a12d50d3a36e067d2271615aa2e7176b740d639e41", "review_method": "ACTUAL_INDIVIDUAL_PNG_VIEW_WITH_SOURCE_TEX_COMPARISON", "review_status": "NEEDS_EVIDENCE_NOT_INSPECTED", "segment_judgment": "NOT_APPLICABLE", "sha256": "3ad1af57b7b045a9983c2c84ea6c3b31810e44b63c44e4ecdcee4dcb59b5d087", "source_version_scope": "CURRENT_UNCHANGED_RECORD", "status": "PASS", "tile": null, "tile_grid": null, "verdict_source": null}
