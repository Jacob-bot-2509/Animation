      "source_records": [
        {
          "id": "test-prob-013",
          "category": "概率论",
          "sub_category": "矩母函数×数字特征",
          "problem": "设 $X\\sim\\operatorname{Poisson}(\\lambda)$。求矩母函数 $M(t)$，并用它求 $E[X]$ 与 $E[X^2]$。",
          "solution": "$M(t)=E[e^{tX}]=\\displaystyle\\sum_{k=0}^{\\infty}e^{tk}\\dfrac{\\lambda^ke^{-\\lambda}}{k!}=e^{-\\lambda}\\sum_{k=0}^{\\infty}\\dfrac{(\\lambda e^t)^k}{k!}=e^{-\\lambda}e^{\\lambda e^t}=e^{\\lambda(e^t-1)}$。$M'(t)=M(t)\\cdot\\lambda e^t$，$M'(0)=\\lambda$，故 $E[X]=\\lambda$。$M''(t)=M(t)\\left[(\\lambda e^t)^2+\\lambda e^t\\right]$，$M''(0)=\\lambda^2+\\lambda$，故 $E[X^2]=\\lambda^2+\\lambda$（与 eval-prob-006 一致）。",
          "answer": "$M(t)=e^{\\lambda(e^t-1)}$；$E[X]=\\lambda$；$E[X^2]=\\lambda^2+\\lambda$",
          "scene_spec": {
            "objects": [
