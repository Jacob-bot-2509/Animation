      "source_records": [
        {
          "id": "test-prob-011",
          "category": "概率论",
          "sub_category": "条件期望×二维均匀",
          "problem": "$(X,Y)$ 在三角形 $D=\\{(x,y):x\\ge 0,\\ y\\ge 0,\\ x+y\\le 2\\}$ 上均匀分布。求条件密度 $f_{Y|X}(y|x)$ 与 $E[Y|X=x]$，并求 $E[Y]$。",
          "solution": "$D$ 面积为 $\\dfrac{1}{2}\\cdot 2\\cdot 2=2$，联合密度 $f(x,y)=\\dfrac{1}{2}$（$(x,y)\\in D$）。边缘密度 $f_X(x)=\\displaystyle\\int_0^{2-x}\\dfrac{1}{2}dy=\\dfrac{2-x}{2}$（$0<x<2$）。条件密度 $f_{Y|X}(y|x)=\\dfrac{f(x,y)}{f_X(x)}=\\dfrac{1}{2-x}$（$0<y<2-x$，即在 $(0,2-x)$ 上均匀）。$E[Y|X=x]=\\dfrac{2-x}{2}$。$E[Y]=\\displaystyle\\int_0^2E[Y|X=x]f_X(x)dx=\\int_0^2\\dfrac{2-x}{2}\\cdot\\dfrac{2-x}{2}dx=\\dfrac{1}{4}\\int_0^2(2-x)^2dx=\\dfrac{1}{4}\\cdot\\dfrac{8}{3}=\\dfrac{2}{3}$。",
          "answer": "$0<x<2$ 时，$f_{Y|X}(y|x)=\\dfrac{1}{2-x}$（$0<y<2-x$，其余 $y$ 处为 0）；$E[Y|X=x]=\\dfrac{2-x}{2}$；$E[Y]=\\dfrac{2}{3}$",
          "scene_spec": {
            "objects": [
              "三角形区域与条件切片",
              "条件期望随 $x$ 变化的直线"
            ],
            "steps": [
