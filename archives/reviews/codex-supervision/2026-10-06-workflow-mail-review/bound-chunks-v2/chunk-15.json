      "source_records": [
        {
          "id": "test-prob-016",
          "category": "概率论",
          "sub_category": "马尔可夫链×稳态分布",
          "problem": "某地天气的转移矩阵为 $P=\\begin{pmatrix}0.8&0.2\\\\0.4&0.6\\end{pmatrix}$（状态 1 晴、状态 2 雨，行表示今天）。求稳态分布。",
          "solution": "稳态分布 $\\pi=(\\pi_1,\\pi_2)$ 满足 $\\pi=\\pi P$ 且 $\\pi_1+\\pi_2=1$：$\\pi_1=0.8\\pi_1+0.4\\pi_2$，即 $0.2\\pi_1=0.4\\pi_2$，$\\pi_1=2\\pi_2$。由 $\\pi_1+\\pi_2=1$：$3\\pi_2=1$，$\\pi_2=\\dfrac{1}{3}$，$\\pi_1=\\dfrac{2}{3}$。故稳态分布 $\\left(\\dfrac{2}{3},\\dfrac{1}{3}\\right)$。",
          "answer": "$\\left(\\dfrac{2}{3},\\dfrac{1}{3}\\right)$",
