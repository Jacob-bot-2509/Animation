      "source_records": [
        {
          "id": "test-x-001",
          "category": "跨学科",
          "sub_category": "概率论×级数",
          "problem": "设 $X$ 服从参数 $p=\\dfrac{1}{2}$ 的几何分布（抛硬币直到正面）。求 $P(X$ 为偶数$)$ 的精确值。",
          "solution": "$P(X=k)=\\left(\\dfrac{1}{2}\\right)^k$。$P(X$ 为偶数$)=\\displaystyle\\sum_{k=1}^{\\infty}P(X=2k)=\\sum_{k=1}^{\\infty}\\left(\\dfrac{1}{2}\\right)^{2k}=\\sum_{k=1}^{\\infty}\\left(\\dfrac{1}{4}\\right)^k=\\dfrac{1/4}{1-1/4}=\\dfrac{1}{3}$。",
          "answer": "$\\dfrac{1}{3}$",
