        {
          "id": "test-geom-019",
          "category": "解析几何",
          "sub_category": "椭圆×距离最值",
          "problem": "求椭圆 $\\dfrac{x^2}{4}+y^2=1$ 上点到 $(1,0)$ 的距离的最大值与最小值。",
          "solution": "参数化 $(2\\cos t,\\sin t)$。$d^2=(2\\cos t-1)^2+\\sin^2t=4\\cos^2t-4\\cos t+1+1-\\cos^2t=3\\cos^2t-4\\cos t+2$。令 $u=\\cos t\\in[-1,1]$，$g(u)=3u^2-4u+2$。$g'(u)=6u-4=0$，$u=\\dfrac{2}{3}$（在 $[-1,1]$ 内）。$g\\left(\\dfrac{2}{3}\\right)=3\\cdot\\dfrac{4}{9}-\\dfrac{8}{3}+2=\\dfrac{4}{3}-\\dfrac{8}{3}+2=\\dfrac{2}{3}$；端点 $g(1)=1$，$g(-1)=3+4+2=9$。故 $d_{\\min}=\\sqrt{\\dfrac{2}{3}}$，$d_{\\max}=3$。",
          "answer": "最小值 $\\sqrt{\\dfrac{2}{3}}$；最大值 $3$",
          "scene_spec": {
            "objects": [
              "椭圆上动点到 $(1,0)$ 的距离变化",
              "最值点标注"
            ],
            "steps": [
              "第一步：建立解析几何·椭圆×距离最值综合场景，呈现与参数方程、距离最值、二次函数相关的核心图形。",
              "第二步：椭圆上动点到 $(1,0)$ 的距离变化。",
              "第三步：最值点标注。",
              "第四步：高亮最终结果与答案。"
            ]
          },
