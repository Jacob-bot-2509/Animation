# -*- coding: utf-8 -*-
"""第四批探针:补齐 F2/F3/F5 的错误码与双向测试、F4 节对象入站。

  F2 管道:容器连宿主管道 → 记录写错误码 + 读宿主下发的 nonce(入站);
           容器自建管道 → 宿主连接并写 nonce → 容器读到即双向通道。
  F3 邮件槽:记录 WriteFile 错误码。
  F5 剪贴板:记录 OpenClipboard 返回值;容器写入尝试 → 宿主读回验证。
  F4 入站节:宿主建 Global 节 → 容器 OpenFileMappingW。
证据写入 probe-ipc4-v1-results.json,绝不覆盖旧文件。
"""
from __future__ import annotations

import ctypes
import json
import socket
import subprocess
import threading
import time
import uuid
from ctypes import wintypes
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
import sys
sys.path.insert(0, str(ROOT / "src"))

from animtrain.sandbox_execution import run_code

HERE = Path(__file__).parent
OUT = HERE / "probe-ipc4-v1-results.json"
if OUT.exists():
    raise ValueError("preserve previous evidence")

NONCE = uuid.uuid4().hex[:12]
k32 = ctypes.WinDLL("kernel32", use_last_error=True)
u32 = ctypes.WinDLL("user32", use_last_error=True)

# HANDLE 安全原型(64 位句柄,防截断)
_kH = ctypes.c_void_p
k32.CreateFileW.restype = _kH
k32.CreateNamedPipeW.restype = _kH
k32.CreateMailslotW.restype = _kH
k32.CreateFileMappingW.restype = _kH
k32.OpenFileMappingW.restype = _kH
k32.OpenEventW.restype = _kH
k32.CloseHandle.argtypes = [_kH]
k32.ConnectNamedPipe.argtypes = [_kH, ctypes.c_void_p]
k32.ReadFile.argtypes = [_kH, ctypes.c_void_p, wintypes.DWORD,
                         ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
k32.WriteFile.argtypes = [_kH, ctypes.c_void_p, wintypes.DWORD,
                          ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
k32.CreateFileMappingW.argtypes = [_kH, ctypes.c_void_p, wintypes.DWORD,
                                   wintypes.DWORD, wintypes.DWORD, wintypes.LPCWSTR]
k32.OpenFileMappingW.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.LPCWSTR]
INVALID = ctypes.c_void_p(-1).value


class PipeServerWrite(threading.Thread):
    """宿主管道:接受容器连接后向容器写 nonce(入站方向测试)。"""
    def __init__(self, name, nonce):
        super().__init__(daemon=True)
        self.name, self.nonce = name, nonce
        self.result = {}

    def run(self):
        h = k32.CreateNamedPipeW(self.name, 2 | 4 | 1, 0, 1, 0, 0, 0, None)
        if h == wintypes.HANDLE(-1).value:
            self.result = {"pipe_create": "failed", "winerror": ctypes.get_last_error()}
            return
        ok = k32.ConnectNamedPipe(h, None)
        buf = ctypes.create_string_buffer(self.nonce.encode())
        n = wintypes.DWORD(0)
        wrote = k32.WriteFile(h, buf, len(self.nonce), ctypes.byref(n), None)
        self.result = {"connect": bool(ok), "write": bool(wrote),
                       "winerror": ctypes.get_last_error()}
        k32.CloseHandle(h)


class HostConnectPipe(threading.Thread):
    """宿主连接容器自建管道并向容器写 nonce(出站→容器收方向)。"""
    def __init__(self, name, nonce):
        super().__init__(daemon=True)
        self.name, self.nonce = name, nonce
        self.result = {}

    def run(self):
        time.sleep(8)  # 等沙箱内管道建立
        h = k32.CreateFileW(self.name, 0xC0000000, 0, None, 3, 0, None)
        if h == wintypes.HANDLE(-1).value:
            self.result = {"open": False, "winerror": ctypes.get_last_error()}
            return
        buf = ctypes.create_string_buffer(self.nonce.encode())
        n = wintypes.DWORD(0)
        wrote = k32.WriteFile(h, buf, len(self.nonce), ctypes.byref(n), None)
        self.result = {"open": True, "write": bool(wrote),
                       "winerror": ctypes.get_last_error()}
        k32.CloseHandle(h)


class HostMailslot(threading.Thread):
    def __init__(self, name):
        super().__init__(daemon=True)
        self.name = name
        self.received = []

    def run(self):
        h = k32.CreateMailslotW(self.name, 0, 0, None)
        if h == wintypes.HANDLE(-1).value:
            self.received.append(("create_failed", ctypes.get_last_error()))
            return
        buf = ctypes.create_string_buffer(256)
        n = wintypes.DWORD(0)
        ok = k32.ReadFile(h, buf, 256, ctypes.byref(n), None)
        k32.CloseHandle(h)
        self.received.append(buf.raw[: n.value].decode("ascii", "replace") if ok else ("read_rc", not ok))


def get_clipboard_text():
    k32.GlobalLock.restype = ctypes.c_void_p
    k32.GlobalLock.argtypes = [ctypes.c_void_p]
    k32.GlobalUnlock.argtypes = [ctypes.c_void_p]
    u32.GetClipboardData.restype = ctypes.c_void_p
    try:
        u32.OpenClipboard(None)
        h = u32.GetClipboardData(13)
        if not h:
            u32.CloseClipboard()
            return None
        p = k32.GlobalLock(h)
        text = ctypes.wstring_at(p) if p else None
        k32.GlobalUnlock(h)
        u32.CloseClipboard()
        return text
    except Exception as exc:
        return "clipboard_error:" + repr(exc)


def main() -> int:
    report = {
        "probe": "ipc4-v1",
        "nonce": NONCE,
        "production_gate": "CLOSED",
        "sandbox": {},
        "after": {},
    }

    # 宿主侧资源
    pipe_srv = PipeServerWrite(r"\\.\pipe\AnimTrainIn4-" + NONCE, "host-pipe-in-" + NONCE)
    pipe_srv.start()
    host_connect = HostConnectPipe(r"\\.\pipe\AnimTrainSbx4-" + NONCE, "host-pipe-out-" + NONCE)
    host_connect.start()
    mailslot = HostMailslot(r"\\.\mailslot\AnimTrainSlot4-" + NONCE)
    mailslot.start()
    # 入站节对象
    section = k32.CreateFileMappingW(INVALID, None, 4, 0, 4096,
                                     "Global\\AnimTrainSec4-" + NONCE)
    time.sleep(0.3)

    probe = r'''
import json,time,ctypes,struct
from ctypes import wintypes
r={}
k32=ctypes.WinDLL("kernel32",use_last_error=True)
u32=ctypes.WinDLL("user32",use_last_error=True)
ctypes.set_last_error(0)
# F2a 容器连宿主管道:打开、写(记录错误码)、读宿主下发的nonce
h=k32.CreateFileW(r"\\.\pipe\AnimTrainIn4-"+__NONCE__,0xC0000000,0,None,3,0,None)
if h==wintypes.HANDLE(-1).value:
 r["pipe_host_open"]={"opened":False,"winerror":ctypes.get_last_error()}
else:
 r["pipe_host_open"]={"opened":True}
 ctypes.set_last_error(0)
 n=wintypes.DWORD(0)
 w=k32.WriteFile(h,ctypes.create_string_buffer(b"sbx-to-host"),11,ctypes.byref(n),None)
 r["pipe_host_write"]={"wrote":bool(w),"winerror":ctypes.get_last_error()}
 ctypes.set_last_error(0)
 buf=ctypes.create_string_buffer(64);n=wintypes.DWORD(0)
 rd=k32.ReadFile(h,buf,64,ctypes.byref(n),None)
 r["pipe_host_read"]={"read":bool(rd),"data":buf.raw[:n.value].decode("ascii","replace"),
                      "winerror":ctypes.get_last_error()}
 k32.CloseHandle(h)
# F2b 容器自建管道,等宿主来连并写 nonce
h=k32.CreateNamedPipeW(r"\\.\pipe\AnimTrainSbx4-"+__NONCE__,2|4|1,0,1,0,0,0,None)
if h==wintypes.HANDLE(-1).value:
 r["pipe_sbx_create"]={"created":False,"winerror":ctypes.get_last_error()}
else:
 r["pipe_sbx_create"]={"created":True}
 ok=k32.ConnectNamedPipe(h,None)
 buf=ctypes.create_string_buffer(64);n=wintypes.DWORD(0)
 rd=k32.ReadFile(h,buf,64,ctypes.byref(n),None)
 r["pipe_sbx_accept"]={"connect":bool(ok),"read":bool(rd),
  "data":buf.raw[:n.value].decode("ascii","replace"),"winerror":ctypes.get_last_error()}
 k32.CloseHandle(h)
# F3 邮件槽:记录写错误码
ctypes.set_last_error(0)
h=k32.CreateFileW(r"\\.\mailslot\AnimTrainSlot4-"+__NONCE__,0x40000000,0,None,3,0,None)
if h==wintypes.HANDLE(-1).value:
 r["mailslot"]={"opened":False,"winerror":ctypes.get_last_error()}
else:
 n=wintypes.DWORD(0)
 w=k32.WriteFile(h,ctypes.create_string_buffer(b"slot-data"),9,ctypes.byref(n),None)
 r["mailslot"]={"opened":True,"wrote":bool(w),"winerror":ctypes.get_last_error()}
 k32.CloseHandle(h)
# F4 入站节:容器打开宿主建的 Global 节
ctypes.set_last_error(0)
h=k32.OpenFileMappingW(4,False,"Global\\AnimTrainSec4-"+__NONCE__)
r["section_inbound"]={"opened":h!=0,"winerror":ctypes.get_last_error()}
if h:k32.CloseHandle(h)
# F5 剪贴板:OpenClipboard 返回值 + 写入尝试
k32.GlobalAlloc.restype=ctypes.c_void_p
k32.GlobalLock.restype=ctypes.c_void_p;k32.GlobalLock.argtypes=[ctypes.c_void_p]
k32.GlobalUnlock.argtypes=[ctypes.c_void_p]
u32.SetClipboardData.argtypes=[wintypes.UINT,ctypes.c_void_p]
ctypes.set_last_error(0)
op=u32.OpenClipboard(None)
r["clip_open"]={"opened":bool(op),"winerror":ctypes.get_last_error()}
if op:
 u32.EmptyClipboard()
 buf=ctypes.create_unicode_buffer("sbx-clip-"+__NONCE__)
 gmh=k32.GlobalAlloc(0x42,(len(buf.value)+1)*2)
 dst=k32.GlobalLock(gmh)
 ctypes.memmove(dst,ctypes.addressof(buf),(len(buf.value)+1)*2)
 k32.GlobalUnlock(gmh)
 rc=u32.SetClipboardData(13,gmh)
 r["clip_set"]={"set":bool(rc),"winerror":ctypes.get_last_error()}
 u32.CloseClipboard()
print(json.dumps(r),flush=True)
'''.replace("__NONCE__", repr(NONCE))

    cp = run_code(probe, mode="probe", timeout_ms=120000)
    report["sandbox"] = {
        "rc": cp["rc"],
        "stdout": cp["stdout"].strip(),
        "stderr": cp["stderr"].strip()[:500],
        "work": cp["work"],
    }
    try:
        report["sandbox"]["results"] = json.loads(cp["stdout"].strip().splitlines()[-1])
    except Exception:
        pass

    time.sleep(1.0)
    pipe_srv.join(timeout=4)
    host_connect.join(timeout=4)
    mailslot.join(timeout=4)
    report["after"]["pipe_host_side"] = pipe_srv.result
    report["after"]["host_connect_pipe"] = host_connect.result
    report["after"]["mailslot_received"] = mailslot.received
    report["after"]["clipboard_after"] = get_clipboard_text()
    if section:
        k32.CloseHandle(section)

    OUT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("sandbox rc:", report["sandbox"]["rc"])
    print("sandbox results:", json.dumps(report["sandbox"].get("results"), ensure_ascii=False))
    print("pipe host side:", report["after"]["pipe_host_side"])
    print("host connect sbx pipe:", report["after"]["host_connect_pipe"])
    print("clipboard after:", report["after"]["clipboard_after"])
    print("evidence:", OUT)
    return 0


if __name__ == "__main__":
    sys.exit(main())
