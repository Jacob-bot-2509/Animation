  "schema": "text-fragment-plan-v2",
  "sources": [
    "\u7528\u51e0\u4f55\u56fe\u5f62\u76f4\u89c2\u5c55\u793a\u53ef\u5217\u53ef\u52a0\u6027\uff1a\u628a\u5355\u4f4d\u6b63\u65b9\u5f62\u5206\u5272\u6210\u53ef\u5217\u4e2a\u4e92\u4e0d\u76f8\u4ea4\u7684\u5c0f\u77e9\u5f62\u3002",
    "\u7b2c\u4e00\u6b65\uff1a\u753b\u51fa\u4e00\u4e2a\u9762\u79ef\u4e3a1\u7684\u5355\u4f4d\u6b63\u65b9\u5f62\u3002",
    "\u7b2c\u4e8c\u6b65\uff1a\u5148\u5206\u5272\u51fa\u4e00\u534a\u9762\u79ef\uff081/2\uff09\u7684\u77e9\u5f62\uff0c\u7528\u84dd\u8272\u586b\u5145\uff0c\u663e\u793a\u90e8\u5206\u548c $S_1 = \\frac{1}{2}$\u3002",
    "\u7b2c\u4e09\u6b65\uff1a\u5728\u5269\u4f59\u7684\u7a7a\u95f4\u4e2d\u518d\u5206\u5272\u51fa 1/4 \u9762\u79ef\u7684\u77e9\u5f62\uff0c\u7528\u7eff\u8272\u586b\u5145\uff0c\u663e\u793a\u90e8\u5206\u548c $S_2 = \\frac{1}{2} + \\frac{1}{4}$\u3002",
    "\u7b2c\u56db\u6b65\uff1a\u63a5\u7740\u4e0d\u65ad\u5206\u5272\u51fa $\\frac{1}{8}, \\frac{1}{16}, \\frac{1}{32}$ \u7b49\u66f4\u5c0f\u7684\u77e9\u5f62\uff0c\u7528\u4e0d\u540c\u989c\u8272\u533a\u5206\u3002",
    "\u7b2c\u4e94\u6b65\uff1a\u968f\u7740\u5206\u5272\u6b21\u6570\u8d8b\u5411\u65e0\u7a77\uff0c\u5269\u4f59\u672a\u5206\u914d\u7684\u9762\u79ef\u8d8a\u6765\u8d8a\u5c0f\uff0c\u6700\u7ec8\u65e0\u9650\u8d8b\u8fd1\u4e8e $0$\u3002",
    "\u7b2c\u516d\u6b65\uff1a\u5c55\u793a\u6c42\u548c\u516c\u5f0f $\\sum_{k=1}^{\\infty} \\frac{1}{2^k} = 1$\uff0c\u6240\u6709\u77e9\u5f62\u9762\u79ef\u4e4b\u548c\u7b49\u4e8e 1\uff0c\u76f4\u89c2\u5c55\u793a\u53ef\u5217\u53ef\u52a0\u6027\u3002",
    "\u53ef\u5217\u53ef\u52a0\u6027\u6210\u7acb\uff1a\u5404\u77e9\u5f62\u9762\u79ef\u6784\u6210\u51e0\u4f55\u7ea7\u6570 $\\sum_{k=1}^{\\infty} \\frac{1}{2^k}$\uff0c\u5176\u548c\u4e3a $1$\uff0c\u6070\u7b49\u4e8e\u5355\u4f4d\u6b63\u65b9\u5f62\u7684\u603b\u9762\u79ef"
  ],
