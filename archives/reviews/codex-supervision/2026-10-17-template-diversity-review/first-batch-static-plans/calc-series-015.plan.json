  "sources": [
    "\u8ba8\u8bba\u7ea7\u6570 $\\sum_{n=1}^{\\infty} \\frac{(-1)^n}{\\sqrt{n}}$ \u7684\u655b\u6563\u6027\uff0c\u5e76\u6307\u51fa\u662f\u7edd\u5bf9\u6536\u655b\u8fd8\u662f\u6761\u4ef6\u6536\u655b\u3002",
    "\u7b2c\u4e00\u6b65\uff1a\u5728\u5de6\u4fa7\u5750\u6807\u7cfb\u4e2d\u4ea4\u66ff\u5411\u4e0a\u548c\u5411\u4e0b\u753b\u51fa\u6b63\u8d1f\u9879\u67f1\u72b6\u56fe\uff0c\u5c55\u793a\u6b63\u8d1f\u4ea4\u66ff\u7684\u6570\u5b66\u5f62\u6001\u3002",
    "\u7b2c\u4e8c\u6b65\uff1a\u7528\u6a59\u8272\u6298\u7ebf\u8fde\u63a5\u90e8\u5206\u548c $S_n$\uff0c\u5c55\u793a\u5b83\u5728\u67d0\u4e00\u4e2a\u6c34\u5e73\u7ebf\u4e0a\u4e0b\u632f\u8361\uff0c\u4f46\u6700\u7ec8\u9010\u6e10\u8d8b\u5411\u4e00\u4e2a\u56fa\u5b9a\u503c\u3002",
    "\u7b2c\u4e09\u6b65\uff1a\u5728\u53f3\u4fa7\u5750\u6807\u7cfb\u4e2d\u753b\u51fa\u7edd\u5bf9\u503c\u7ea7\u6570 $\\sum \\frac{1}{\\sqrt{n}}$ \u7684\u67f1\u72b6\u56fe\uff0c\u5c55\u793a\u5176\u9ad8\u5ea6\u9012\u51cf\u6781\u5176\u7f13\u6162\u3002",
    "\u7b2c\u56db\u6b65\uff1a\u7528\u6298\u7ebf\u5c55\u793a\u7edd\u5bf9\u503c\u7ea7\u6570\u7684\u90e8\u5206\u548c\u8f68\u8ff9\uff0c\u4e00\u76f4\u5411\u53f3\u4e0a\u65b9\u65e0\u9650\u5ef6\u4f38\uff0c\u76f4\u767d\u5730\u8bc1\u660e\u5176\u53d1\u6563\u3002",
    "\u7b2c\u4e94\u6b65\uff1a\u540c\u65f6\u5c55\u793a\u4e24\u5e45\u56fe\uff0c\u5bf9\u6bd4\u8bf4\u660e\u201c\u539f\u7ea7\u6570\u6536\u655b\uff0c\u4f46\u7edd\u5bf9\u503c\u7ea7\u6570\u53d1\u6563\uff0c\u56e0\u6b64\u6761\u4ef6\u6536\u655b\u201d\u3002",
    "\u6761\u4ef6\u6536\u655b"
  ],
