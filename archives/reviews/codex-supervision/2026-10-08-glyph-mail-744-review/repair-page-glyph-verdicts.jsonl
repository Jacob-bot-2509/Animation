{"formulas": [{"index": 10, "tex": "V=\\pi\\displaystyle\\int_0^1\\left[(\\pi-\\arcsin y)^2-(\\arcsin y)^2\\right]dy=\\pi\\int_0^1(\\pi^2-2\\pi\\arcsin y)\\,dy=\\pi\\left[\\pi^2-2\\pi\\int_0^1\\arcsin y\\,dy\\right]"}], "id": "eval-calc-030-s3", "kind": "FORMULA_SEGMENT", "math_qualification": "PASS_EXACT_INTEGRAL_AND_INDEPENDENT_SHELL_METHOD", "math_sha256": "be1651eec1f5a4d47e7dd3c1517915d1efbb98518da569cf54ca9c3a6c6efbe8", "notes": "第 1/2 段积分 0..1、差平方和等式字形完整；结合下一段核对整式。", "ordinal": 196, "page": 3, "path": "reviews/codex-supervision/2026-10-08-glyph-mail-744-review/repair-render/pages/page-003.png", "record_sha256": "3d8cae8b875dc6aa0abae391a988e9e527e155ae035094725f26f457773880ea", "review_method": "ACTUAL_INDIVIDUAL_NEW_CANDIDATE_PNG_VIEW_3840x2160_DISPLAYED_2048x1152_WITH_TEX_COMPARISON", "segment_judgment": "PASS_ADJACENT_SEGMENTS_JOIN_AND_OVERLAP", "sha256": "5d45cba7ac2adf8be7e2a4e019d52fde323aa14d8f8d801f45ae6afafcdf4043", "status": "PASS", "symbols_checked": "See page-specific notes", "tile": [0, 0], "tile_grid": [1, 2]}
