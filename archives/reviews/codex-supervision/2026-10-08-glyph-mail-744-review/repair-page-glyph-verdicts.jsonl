{"formulas": [{"index": 11, "tex": "\\displaystyle\\int_0^1\\arcsin y\\,dy=\\left[y\\arcsin y+\\sqrt{1-y^2}\\right]_0^1=\\dfrac{\\pi}{2}-1"}, {"index": 12, "tex": "V=\\pi\\left[\\pi^2-2\\pi\\left(\\dfrac{\\pi}{2}-1\\right)\\right]=\\pi\\left[\\pi^2-\\pi^2+2\\pi\\right]=2\\pi^2"}, {"index": 13, "tex": "2\\pi^2"}, {"index": 14, "tex": "\\pi-\\arcsin y"}, {"index": 15, "tex": "\\arcsin y"}], "id": "eval-calc-030-s3", "kind": "FULL_FORMULAS", "math_qualification": "PASS_EXACT_INTEGRAL_AND_INDEPENDENT_SHELL_METHOD", "math_sha256": "be1651eec1f5a4d47e7dd3c1517915d1efbb98518da569cf54ca9c3a6c6efbe8", "notes": "arcsin 原函数端点评价、π/2−1、根号与 V=2π² 清晰，无分数线或指数重叠。", "ordinal": 198, "page": 5, "path": "reviews/codex-supervision/2026-10-08-glyph-mail-744-review/repair-render/pages/page-005.png", "record_sha256": "3d8cae8b875dc6aa0abae391a988e9e527e155ae035094725f26f457773880ea", "review_method": "ACTUAL_INDIVIDUAL_NEW_CANDIDATE_PNG_VIEW_3840x2160_DISPLAYED_2048x1152_WITH_TEX_COMPARISON", "segment_judgment": "NOT_APPLICABLE", "sha256": "2bf400a1f2fa7d08fd845805bf161bd4ee51536d530bd9e3e42257e26a3d81aa", "status": "PASS", "symbols_checked": "See page-specific notes", "tile": null, "tile_grid": null}
