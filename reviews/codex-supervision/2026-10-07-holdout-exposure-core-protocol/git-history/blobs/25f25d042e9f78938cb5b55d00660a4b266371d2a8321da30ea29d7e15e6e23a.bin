[
{"id": "prob-038", "category": "概率论", "sub_category": "条件概率与独立性", "function_family": "事件关系与韦恩图", "visual_style": "集合运算与面积动态切割", "efficiency_tags": ["条件概率空间缩减", "交并集高亮"], "problem": "已知事件 $A$ 与 $B$ 的概率分别为 $P(A) = 0.6$，$P(B) = 0.4$，且 $P(A \\cap B) = 0.2$。求条件概率 $P(A|B)$ 和 $P(B|A)$。", "solution": "根据条件概率公式，$P(A|B) = \\frac{P(A \\cap B)}{P(B)} = \\frac{0.2}{0.4} = 0.5$。$P(B|A) = \\frac{P(A \\cap B)}{P(A)} = \\frac{0.2}{0.6} = \\frac{1}{3}$。可以直观理解为在缩减的样本空间 $B$ 或 $A$ 中，交集部分所占的比例。", "answer": "$P(A|B) = 0.5$，$P(B|A) = \\frac{1}{3}$", "scene_spec": {"objects": ["矩形样本空间", "蓝色圆 A", "红色圆 B", "交集区域（紫色）"], "steps": ["第一步：画出一个正方形代表总样本空间，画出相交的圆 A 和圆 B，并用韦恩图表示它们的概率面积。", "第二步：给交集部分涂上紫色，标注 $P(A \\cap B) = 0.2$。", "第三步：动态展示“条件概率”的空间缩减过程，将圆 B 以外的区域变为灰色，强调样本空间现在变成了 B。", "第四步：在缩小后的空间 B 中，高亮紫色交集部分的占比，直观展示 $P(A|B) = 0.5$。", "第五步：同样地，动态演示缩小到空间 A 的情况，得出 $P(B|A) = \\frac{1}{3}$。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-039", "category": "概率论", "sub_category": "几何概型", "function_family": "连续均匀分布与随机投点", "visual_style": "空间撒点与频率逼近", "efficiency_tags": ["面积比计算", "大数定律直观展示"], "problem": "利用几何概型的思想，说明如何通过随机投点估算圆周率 $\\pi$ 的值。", "solution": "考虑边长为2的正方形内切一个半径为1的圆。正方形的面积为4，圆的面积为 $\\pi$。如果向正方形内随机投掷 $n$ 个点，点落在圆内的概率为 $P = \\frac{\\pi}{4}$。随着投掷次数 $n$ 增大，落入圆内的点频数 $m$ 与 $n$ 的比值 $\\frac{m}{n}$ 会趋近于 $\\frac{\\pi}{4}$，从而可以估算 $\\pi \\approx \\frac{4m}{n}$。", "answer": "$\\pi \\approx \\frac{4m}{n}$", "scene_spec": {"objects": ["平面直角坐标系", "正方形区域", "内切圆区域", "随机散点", "动态更新的公式"], "steps": ["第一步：绘制一个边长为2，中心在原点的正方形，并画出它的内切圆。", "第二步：用程序生成均匀分布的随机点，让这些点像下雨一样落在正方形内。", "第三步：落在圆内的点显示为蓝色，落在圆外的点显示为灰色，动态统计蓝点的个数。", "第四步：右侧实时展示估算公式 $\\pi \\approx \\frac{4m}{n}$，随着点数增加，数字逐渐逼近 $3.14159...$。", "第五步：对比展示理论值，直观揭示频率的稳定性和大数定律。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-040", "category": "概率论", "sub_category": "常见分布", "function_family": "二项分布与泊松分布", "visual_style": "柱状图动态逼近", "efficiency_tags": ["参数调整", "离散分布极限"], "problem": "说明当 $n$ 很大，$p$ 很小时，二项分布 $B(n, p)$ 可以近似为泊松分布 $P(\\lambda)$，其中 $\\lambda = np$。", "solution": "二项分布的概率质量函数为 $P(X=k) = \\binom{n}{k} p^k (1-p)^{n-k}$。当 $n \\to \\infty$，$p \\to 0$ 且 $np \\to \\lambda$ 时，利用极限 $\\lim_{n \\to \\infty} (1 - \\frac{\\lambda}{n})^n = e^{-\\lambda}$，可以推导出 $P(X=k) \\to \\frac{\\lambda^k e^{-\\lambda}}{k!}$，这正是泊松分布的概率质量函数。", "answer": "当 $n \\to \\infty$、$p \\to 0$ 且 $np \\to \\lambda$ 时，$B(n,p)$ 的概率质量函数趋近于泊松分布 $P(\\lambda)$ 的概率质量函数 $\\frac{\\lambda^k e^{-\\lambda}}{k!}$", "scene_spec": {"objects": ["直角坐标系", "二项分布柱状图", "泊松分布理想曲线", "动态变化的参数滑块"], "steps": ["第一步：在坐标系中绘制二项分布 $B(n,p)$ 的柱状图，初始设定 $n=10, p=0.5$。", "第二步：在画面右侧引入一个滑块，拖动滑块使得 $n$ 逐渐增大（如 $n=50, 100$），同时 $p$ 逐渐减小。", "第三步：保持 $\\lambda = np = 5$ 固定，展示随着 $n$ 增大柱状图中心始终位于 5、方差由 2.5 逐渐趋近 5，形态收敛到固定的泊松分布 $P(5)$。", "第四步：叠加上一条红色的泊松分布理论曲线，展示当 $n$ 很大 $p$ 很小时，二项分布的柱状图顶端几乎完全与红色曲线重合，验证泊松近似。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-041", "category": "概率论", "sub_category": "常见分布", "function_family": "正态分布", "visual_style": "连续曲线与参数动态调整", "efficiency_tags": ["均值和方差几何意义", "概率密度函数高亮"], "problem": "分析正态分布 $X \\sim N(\\mu, \\sigma^2)$ 的概率密度函数，说明参数 $\\mu$ 和 $\\sigma$ 对曲线形状的影响。", "solution": "正态分布的概率密度函数为 $f(x) = \\frac{1}{\\sqrt{2\\pi}\\sigma} e^{-\\frac{(x-\\mu)^2}{2\\sigma^2}}$。参数 $\\mu$ 是位置参数，决定曲线的对称轴位置；参数 $\\sigma$ 是尺度参数，决定曲线的陡峭程度（$\\sigma$ 越大，曲线越矮胖；$\\sigma$ 越小，曲线越高瘦）。", "answer": "$\\mu$ 决定位置，$\\sigma$ 决定形状的陡峭程度", "scene_spec": {"objects": ["直角坐标系", "正态分布钟形曲线", "$\\mu$ 滑块", "$\\sigma$ 滑块", "阴影面积高亮"], "steps": ["第一步：绘制标准正态分布曲线 $N(0,1)$，并高亮曲线下方面积为1。", "第二步：拖动 $\\mu$ 滑块，展示曲线在水平方向上左右平移，而形状完全不变。", "第三步：拖动 $\\sigma$ 滑块，展示曲线以 $\\mu$ 为中心变宽或变窄，同时高度发生反向变化以保持总面积为1。", "第四步：在曲线上用阴影标记出 $\\mu \\pm \\sigma$ 区间，展示该区间的概率面积约为 $0.6827$，$\\mu \\pm 2\\sigma$ 约为 $0.9545$。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-042", "category": "概率论", "sub_category": "大数定律", "function_family": "伯努利大数定律", "visual_style": "动态折线与频率收敛", "efficiency_tags": ["动态收敛轨迹", "水平极限线"], "problem": "利用伯努利大数定律，说明抛硬币试验中正面出现的频率是如何随试验次数增加而趋于其概率的。", "solution": "设 $X_i$ 为第 $i$ 次抛硬币的指示变量（正面为1，反面为0），$P(X_i=1) = p = 0.5$。伯努利大数定律指出，对于任意 $\\epsilon > 0$，有 $\\lim_{n \\to \\infty} P\\left( \\left| \\frac{1}{n} \\sum_{i=1}^n X_i - p \\right| < \\epsilon \\right) = 1$。即当试验次数 $n$ 趋近于无穷大时，正面出现的频率依概率收敛于其理论概率 $0.5$。", "answer": "频率依概率收敛于 $0.5$", "scene_spec": {"objects": ["二维坐标系", "收敛水平线 $y=0.5$", "动态折线图", "不断累加的硬币图标"], "steps": ["第一步：在坐标系中画出横轴（试验次数 n）和纵轴（正面频率），并画一条红色的水平虚线表示极限概率 $0.5$。", "第二步：模拟抛硬币过程，随着硬币不断被抛出（动态画面），折线图从左向右延伸。", "第三步：折线在初始阶段（n 较小时）波动剧烈，经常上下大幅跳动。", "第四步：随着试验次数 $n$ 增大（如 $n=1000, 10000$），折线震荡幅度越来越小。", "第五步：最终，折线几乎紧贴并收敛于红色虚线 $y=0.5$，直观演示大数定律。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-043", "category": "概率论", "sub_category": "中心极限定理", "function_family": "独立同分布中心极限定理", "visual_style": "分屏对比与分布形态演变", "efficiency_tags": ["样本量滑块", "直方图对比"], "problem": "解释中心极限定理的核心内容，并说明当样本量 n 增大时，样本均值的分布是如何变化的。", "solution": "设随机变量 $X_1, X_2, \\dots, X_n$ 相互独立且同分布，具有有限的数学期望 $\\mu$ 和方差 $\\sigma^2$。中心极限定理指出，当 $n$ 充分大时，标准化样本均值 $\\frac{\\bar{X} - \\mu}{\\sigma / \\sqrt{n}}$ 的分布近似于标准正态分布 $N(0, 1)$。直观来说，样本均值的方差为 $\\sigma^2/n$，随着 $n$ 增大，方差减小，分布变得更加集中，直方图会变高变窄，最终趋于钟形正态分布。", "answer": "样本均值 $\\bar{X}$ 的分布趋近于正态分布 $N(\\mu, \\sigma^2/n)$：随着 $n$ 增大，分布变高变窄、中心不变。", "scene_spec": {"objects": ["左侧原始总体分布（如均匀分布或指数分布）", "右侧动态样本均值分布直方图", "样本量 n 滑块", "目标正态曲线 $N(\\mu, \\sigma^2/n)$"], "steps": ["第一步：屏幕左侧显示一个明显非正态的总体分布（例如均匀分布），明确标注其形态。", "第二步：在右侧从该总体中随机抽取 n 个样本并计算均值，重复多次绘制直方图。", "第三步：初始设置 n=2，右侧直方图呈现出与总体相似的粗糙形态。", "第四步：动画拖动“样本量 n”滑块，将 n 逐渐增大至 5, 10, 30。", "第五步：右侧的直方图动态且平滑地变高变窄，形态逐渐转变成钟形。", "第六步：叠加红色曲线 $N(\\mu, \\sigma^2/n)$，展示当 n=30 时，样本均值直方图几乎与红色曲线重合。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-044", "category": "概率论", "sub_category": "贝叶斯公式", "function_family": "条件概率与贝叶斯推断", "visual_style": "面积分割与信念动态更新", "efficiency_tags": ["树状图或面积图", "先验与后验对比"], "problem": "某种疾病的患病率为 0.1%（即千分之一）。有一种检测方法，对于患病者检测出阳性的概率为 99%，对于未患病者检测出阴性的概率为 99%，相应地假阳性率为 1%。若某人检测结果为阳性，求他实际患病的概率。", "solution": "设事件 D 表示患病，T 表示检测为阳性。已知 $P(D) = 0.001, P(\\neg D) = 0.999$。灵敏度 $P(T|D) = 0.99$，假阳性率 $P(T|\\neg D) = 0.01$。根据贝叶斯公式：$P(D|T) = \\frac{P(T|D)P(D)}{P(T|D)P(D) + P(T|\\neg D)P(\\neg D)} = \\frac{0.99 \\times 0.001}{0.99 \\times 0.001 + 0.01 \\times 0.999} = \\frac{0.00099}{0.00099 + 0.00999} \\approx 0.0902$。即虽然检测为阳性，实际患病的概率仅约 9.02%。", "answer": "约 9.02%", "scene_spec": {"objects": ["矩形面积图", "患病和未患病的面积块", "检测阳性的高亮区域", "贝叶斯公式动态代入"], "steps": ["第一步：绘制一个面积代表总人口（如 100000 人），按千分之一比例分割出极小的一块红色区域代表“患病”。", "第二步：将患病区域进一步分割，99% 的部分涂上深红色代表“患病且阳性”，1% 涂灰色。", "第三步：在未患病区域（99.9%）中，分割出 1% 的黄色区域代表“未患病且阳性”。", "第四步：整体高亮所有“检测阳性”的区域（深红加黄色），形成条件样本空间。", "第五步：动态计算深红色面积在总阳性区域中的占比，展示比例数字 9.02%，揭示直觉与数学计算之间的巨大反差。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-045", "category": "概率论", "sub_category": "随机变量函数的分布", "function_family": "一维随机变量变换", "visual_style": "分布映射与密度函数迁移", "efficiency_tags": ["分布函数法", "几何映射"], "problem": "设随机变量 $X$ 服从区间 $(0, 1)$ 上的均匀分布，求 $Y = X^2$ 的概率密度函数。", "solution": "已知 $X \\sim U(0,1)$，其概率密度函数为 $f_X(x) = 1$（当 $0 < x < 1$）。采用分布函数法：先求 $Y$ 的分布函数 $F_Y(y) = P(Y \\le y) = P(X^2 \\le y) = P(-\\sqrt{y} \\le X \\le \\sqrt{y})$。因为 $X \\in (0,1)$，所以 $F_Y(y) = P(0 < X \\le \\sqrt{y}) = \\sqrt{y}$（当 $0 < y < 1$）。对 $y$ 求导得 $f_Y(y) = F_Y'(y) = \\frac{1}{2\\sqrt{y}}$。", "answer": "$f_Y(y) = \\frac{1}{2\\sqrt{y}}$，其中 $0 < y < 1$", "scene_spec": {"objects": ["二维坐标系（左展示x，上展示y）", "均匀分布密度曲线 $f_X(x)$", "映射函数 $y=x^2$", "变换后的概率密度曲线 $f_Y(y)$"], "steps": ["第一步：在坐标系中画出X轴方向上的均匀分布密度 $f_X(x)=1$，这是一个高度为1的矩形。", "第二步：画出函数曲线 $y = x^2$，将X轴上的区间映射到Y轴。", "第三步：在X轴上动态移动一个小区间 $\\Delta x$，映射到Y轴上成为区间 $\\Delta y$。", "第四步：展示概率守恒原理，$\\Delta x$ 对应的面积必须等于 $\\Delta y$ 对应的面积。", "第五步：随着X轴上的点靠近0，映射到Y轴后，区间被压缩，导致概率密度 $f_Y(y)$ 在0附近无限拔高，右侧向1方向逐渐衰减，最终动态绘出 $1/(2\\sqrt{y})$ 的曲线。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"},
{"id": "prob-046", "category": "概率论", "sub_category": "可列可加性", "function_family": "测度的可列可加性", "visual_style": "无限级数面积拼图", "efficiency_tags": ["几何级数", "极限逼近"], "problem": "用几何图形直观展示可列可加性：把单位正方形分割成可列个互不相交的小矩形。", "solution": "将面积为 $1$ 的正方形依次分割：第一个矩形面积为 $\\frac{1}{2}$，第二个为 $\\frac{1}{4}$，第三个为 $\\frac{1}{8}$，依此类推。随着分割次数趋向无穷，矩形面积构成几何级数 $\\sum_{k=1}^{\\infty} \\frac{1}{2^k}$，其和为 $1$。这直观展示了可列可加性。", "answer": "1，即所有事件概率之和为1", "scene_spec": {"objects": ["单位正方形", "不断细分的矩形区域", "动态更新的概率求和公式"], "steps": ["第一步：画出一个面积为1的单位正方形。", "第二步：先分割出一半面积（1/2）的矩形，用蓝色填充，显示部分和 $S_1 = \\frac{1}{2}$。", "第三步：在剩余的空间中再分割出 1/4 面积的矩形，用绿色填充，显示部分和 $S_2 = \\frac{1}{2} + \\frac{1}{4}$。", "第四步：接着不断分割出 $\\frac{1}{8}, \\frac{1}{16}, \\frac{1}{32}$ 等更小的矩形，用不同颜色区分。", "第五步：随着分割次数趋向无穷，剩余未分配的面积越来越小，最终无限趋近于 $0$。", "第六步：展示求和公式 $\\sum_{k=1}^{\\infty} \\frac{1}{2^k} = 1$，所有矩形面积之和等于 1，直观展示可列可加性。"]}, "source": "self-authored", "license": "Internal-Research-Use-Only"}
]
