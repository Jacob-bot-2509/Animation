  "sources": [
    "\u89e3\u91ca\u4e2d\u5fc3\u6781\u9650\u5b9a\u7406\u7684\u6838\u5fc3\u5185\u5bb9\uff0c\u5e76\u8bf4\u660e\u5f53\u6837\u672c\u91cf n \u589e\u5927\u65f6\uff0c\u6837\u672c\u5747\u503c\u7684\u5206\u5e03\u662f\u5982\u4f55\u53d8\u5316\u7684\u3002",
    "\u7b2c\u4e00\u6b65\uff1a\u5c4f\u5e55\u5de6\u4fa7\u663e\u793a\u4e00\u4e2a\u660e\u663e\u975e\u6b63\u6001\u7684\u603b\u4f53\u5206\u5e03\uff08\u4f8b\u5982\u5747\u5300\u5206\u5e03\uff09\uff0c\u660e\u786e\u6807\u6ce8\u5176\u5f62\u6001\u3002",
    "\u7b2c\u4e8c\u6b65\uff1a\u5728\u53f3\u4fa7\u4ece\u8be5\u603b\u4f53\u4e2d\u968f\u673a\u62bd\u53d6 n \u4e2a\u6837\u672c\u5e76\u8ba1\u7b97\u5747\u503c\uff0c\u91cd\u590d\u591a\u6b21\u7ed8\u5236\u76f4\u65b9\u56fe\u3002",
    "\u7b2c\u4e09\u6b65\uff1a\u521d\u59cb\u8bbe\u7f6e n=2\uff0c\u6837\u672c\u5747\u503c\u7684\u76f4\u65b9\u56fe\u5df2\u5448\u73b0\u4e09\u89d2\u5206\u5e03\uff08Irwin\u2013Hall \u5206\u5e03\uff09\uff0c\u4e0e\u539f\u59cb\u5747\u5300\u603b\u4f53\u660e\u663e\u4e0d\u540c\u3002",
    "\u7b2c\u56db\u6b65\uff1a\u52a8\u753b\u62d6\u52a8\u201c\u6837\u672c\u91cf n\u201d\u6ed1\u5757\uff0c\u5c06 n \u9010\u6e10\u589e\u5927\u81f3 5, 10, 30\u3002",
    "\u7b2c\u4e94\u6b65\uff1a\u53f3\u4fa7\u7684\u76f4\u65b9\u56fe\u52a8\u6001\u4e14\u5e73\u6ed1\u5730\u53d8\u9ad8\u53d8\u7a84\uff0c\u5f62\u6001\u9010\u6e10\u8f6c\u53d8\u6210\u949f\u5f62\u3002",
    "\u7b2c\u516d\u6b65\uff1a\u53e0\u52a0\u7ea2\u8272\u66f2\u7ebf $N(\\mu, \\sigma^2/n)$\uff0c\u5c55\u793a\u5f53 n=30 \u65f6\uff0c\u6837\u672c\u5747\u503c\u76f4\u65b9\u56fe\u51e0\u4e4e\u4e0e\u7ea2\u8272\u66f2\u7ebf\u91cd\u5408\u3002",
    "\u6837\u672c\u5747\u503c $\\bar{X}$ \u7684\u5206\u5e03\u8d8b\u8fd1\u4e8e\u6b63\u6001\u5206\u5e03 $N(\\mu, \\sigma^2/n)$\uff1a\u968f\u7740 $n$ \u589e\u5927\uff0c\u5206\u5e03\u53d8\u9ad8\u53d8\u7a84\u3001\u4e2d\u5fc3\u4e0d\u53d8\u3002"
  ],
