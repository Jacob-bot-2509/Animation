{
  "schema": "text-fragment-plan-v2",
  "sources": [
    "\u5229\u7528\u4f2f\u52aa\u5229\u5927\u6570\u5b9a\u5f8b\uff0c\u8bf4\u660e\u629b\u786c\u5e01\u8bd5\u9a8c\u4e2d\u6b63\u9762\u51fa\u73b0\u7684\u9891\u7387\u662f\u5982\u4f55\u968f\u8bd5\u9a8c\u6b21\u6570\u589e\u52a0\u800c\u8d8b\u4e8e\u5176\u6982\u7387\u7684\u3002",
    "\u7b2c\u4e00\u6b65\uff1a\u5728\u5750\u6807\u7cfb\u4e2d\u753b\u51fa\u6a2a\u8f74\uff08\u8bd5\u9a8c\u6b21\u6570 n\uff09\u548c\u7eb5\u8f74\uff08\u6b63\u9762\u9891\u7387\uff09\uff0c\u5e76\u753b\u4e00\u6761\u7ea2\u8272\u7684\u6c34\u5e73\u865a\u7ebf\u8868\u793a\u6781\u9650\u6982\u7387 $0.5$\u3002",
    "\u7b2c\u4e8c\u6b65\uff1a\u6a21\u62df\u629b\u786c\u5e01\u8fc7\u7a0b\uff0c\u968f\u7740\u786c\u5e01\u4e0d\u65ad\u88ab\u629b\u51fa\uff08\u52a8\u6001\u753b\u9762\uff09\uff0c\u6298\u7ebf\u56fe\u4ece\u5de6\u5411\u53f3\u5ef6\u4f38\u3002",
    "\u7b2c\u4e09\u6b65\uff1a\u6298\u7ebf\u5728\u521d\u59cb\u9636\u6bb5\uff08n \u8f83\u5c0f\u65f6\uff09\u6ce2\u52a8\u5267\u70c8\uff0c\u7ecf\u5e38\u4e0a\u4e0b\u5927\u5e45\u8df3\u52a8\u3002",
    "\u7b2c\u56db\u6b65\uff1a\u968f\u7740\u8bd5\u9a8c\u6b21\u6570 $n$ \u589e\u5927\uff08\u5982 $n=1000, 10000$\uff09\uff0c\u6298\u7ebf\u9707\u8361\u5e45\u5ea6\u8d8a\u6765\u8d8a\u5c0f\u3002",
    "\u7b2c\u4e94\u6b65\uff1a\u6700\u7ec8\uff0c\u6298\u7ebf\u51e0\u4e4e\u7d27\u8d34\u5e76\u6536\u655b\u4e8e\u7ea2\u8272\u865a\u7ebf $y=0.5$\uff0c\u76f4\u89c2\u6f14\u793a\u5927\u6570\u5b9a\u5f8b\u3002",
    "\u9891\u7387\u4f9d\u6982\u7387\u6536\u655b\u4e8e $0.5$"
  ],
