{
  "//": "manim 0.21 API 白名单示例(可配置)。前项目以'内省运行中的 manim'为真值,本机无 manim 环境,暂用白名单文件;渲染环境就位后恢复内省方式。",
  "allowed": [
    "Scene", "ThreeDScene", "Axes", "NumberPlane", "PolarPlane", "ThreeDAxes",
    "Circle", "Square", "Triangle", "Polygon", "RegularPolygon", "Star",
    "Line", "DashedLine", "Arrow", "Vector", "Dot", "Ellipse", "Arc",
    "Sector", "Annulus", "Rectangle", "Brace", "Angle", "RightAngle",
    "TangentLine", "VGroup", "Group", "MathTex", "Tex", "Text", "MarkupText",
    "Title", "BulletedList", "Matrix", "Table", "DecimalNumber", "Integer",
    "Variable", "ValueTracker", "ParametricFunction", "Surface", "Sphere",
    "Torus", "Cylinder", "Cone", "Graph", "DiGraph", "BarChart", "NumberLine",
    "Create", "FadeIn", "FadeOut", "Transform", "ReplacementTransform",
    "TransformMatchingTex", "Write", "Indicate", "Circumscribe", "Flash",
    "Rotate", "Scale", "MoveAlongPath", "GrowArrow", "GrowFromCenter",
    "AnimationGroup", "LaggedStart", "Succession", "Restore", "ApplyMatrix",
    "Uncreate", "BLUE", "RED", "GREEN", "YELLOW", "GREY", "WHITE", "BLACK",
    "UP", "DOWN", "LEFT", "RIGHT", "ORIGIN", "UL", "UR", "DL", "DR",
    "PI", "TAU", "DEGREES", "always_redraw", "np", "numpy"
  ],
  "note": "白名单只管构造调用 Klass(...);方法调用与 * 导入的符号不做静态检查(如实,不伪造)。渲染环境就位后换内省真值。"
}
