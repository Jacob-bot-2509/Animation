{"display_preview": "2048x1152; bound original PNG 3840x2160", "formulas": [{"index": 11, "tex": "a_n\\le\\sum_{k=0}^{n}\\dfrac{1}{k!}\\le 1+1+\\dfrac{1}{2}+\\dfrac{1}{4}+\\cdots+\\dfrac{1}{2^{n-1}}<3"}, {"index": 12, "tex": "\\lim a_n"}, {"index": 13, "tex": "E=\\sum_{k=0}^{\\infty}1/k!"}, {"index": 14, "tex": "k!\\ge2^{k-1}"}, {"index": 15, "tex": "k\\ge1"}], "id": "eval-calc-003-s1", "index_sha256": "07b4543d38599e1c30d2b515e0c2a8761e5611f771c46c75ee23b357c58b6331", "kind": "FULL_FORMULAS", "math_sha256": "fc4b5003b893ee4474a6023cb7eb5c1c6061cc2cb5f79d98f6cc156582e3145f", "notes": "Items 11-15: finite factorial sum, geometric bound through 2^(n-1), strict <3, limit, infinite sum, factorial lower bound and k>=1 are clear.", "ordinal": 112, "page": 3, "path": "reviews/codex-supervision/2026-10-08-hd-formula-mail-review/shard-1/render-eval-calc-003-s1/pages/page-003.png", "record_sha256": "c191634c3714939e342d6cb4c5c281954af79cdcdb6d5bef0ef6280615fa6e10", "review_method": "MODEL_ACTUAL_IMAGE_INSPECTION_PLUS_BOUND_TEX_COMPARISON", "reviewed_at": "2026-10-08T09:37:04.457978+08:00", "segment_judgment": "FULL_FORMULAS", "sha256": "ae142c17a210e0d05f270820987dbd3bbaf21ee443934d07e669e2851bfd91f4", "status": "PASS", "symbols_checked": [11, 12, 13, 14, 15], "tile": null, "tile_grid": null}
