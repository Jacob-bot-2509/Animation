      <Command>C:\windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -File "D:\Animation-Model-Training\reviews\codex-supervision\2026-10-08-auto-mail\run_mail_task.ps1"</Arguments>
