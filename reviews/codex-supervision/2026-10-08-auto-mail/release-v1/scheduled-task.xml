<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Every 10 minutes, capture Claude mail and queue bounded review in the existing Codex thread.</Description>
    <URI>\Animation-Codex-Claude-Mail-10min</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-3255372660-1198139168-2246013942-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
